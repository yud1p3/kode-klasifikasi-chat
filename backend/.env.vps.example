# ============================================================
# TEMPLATE .env untuk VPS PRODUKSI — kode-klasifikasi-meili
#
# Salin ke folder binary di VPS (berdampingan dengan kode-klasifikasi-chat):
#   cp backend/.env.vps.example ~/kode-klasifikasi-meili/.env
#   nano ~/kode-klasifikasi-meili/.env    # isi semua nilai GANTI-*
#
# ⚠️ JANGAN commit file .env ini ke git.
# ⚠️ DELETE_SECRET: hindari karakter $ # dan spasi (atau bungkus '...').
#    Lihat catatan dotenv di PANDUAN_DEPLOY_VPS.md §5.
# ============================================================

# --- Database PostgreSQL (VPS) ---
DATABASE_URL=postgres://postgres:GANTI-PASSWORD@127.0.0.1:5432/klasifikasi_arsip

# --- Gemini API Keys (multi, comma-separated; rotasi otomatis) ---
GEMINI_API_KEYS=key1,key2,key3
# Fallback single key bila tidak pakai multi: GEMINI_API_KEY=...

# --- Server ---
HOST=0.0.0.0
PORT=3000

# --- Meilisearch VPS (master key BEDA dari lokal!) ---
SEARCH_BACKEND=meili
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=GANTI-DENGAN-MASTER-KEY-VPS
MEILI_INDEX=klasifikasi_embedding
MEILI_HYBRID=0

# --- Kuota free Gemini (opsional; default konservatif free tier) ---
# QUOTA_ENABLED=1
# QUOTA_CHAT_RPM=10
# QUOTA_CHAT_RPD=250
# QUOTA_EMBED_RPM=100
# QUOTA_EMBED_RPD=10000

# --- Google OAuth (client ID/SECRET sama dengan lokal) ---
GOOGLE_CLIENT_ID=GANTI-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GANTI-client-secret
# Redirect URI domain ngrok VPS (comma-separated, boleh lebih dari satu)
GOOGLE_REDIRECT_URI=https://liqueur-douche-defuse.ngrok-free.dev/auth/callback
# JWT_SECRET: WAJIB BARU (bukan dari lokal) — 32+ karakter acak
JWT_SECRET=GANTI-DENGAN-STRING-ACAK-32-KARAKTER
# JWT_EXP_SECS=43200

# --- Admin feedback (fitur hapus) ---
ADMIN_EMAILS=admin@dinas.go.id
# DELETE_SECRET: hindari karakter $ # spasi — atau bungkus dengan '...'
DELETE_SECRET='GANTI-DENGAN-KALIMAT-ACAK'
# DELETE_MAX_ATTEMPTS=5
# DELETE_LOCKOUT_SECS=900
